<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The export bot's weekly run (Mondays 9:30 AM). OFF unless you install it with install.sh --with-bot
     AND set "enabled": true in bot-config.json. Read README.txt first. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.defiedmgmt.luminate-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__APP__/export-bot.mjs</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__LOGS__/bot.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/bot.log</string>
</dict>
</plist>

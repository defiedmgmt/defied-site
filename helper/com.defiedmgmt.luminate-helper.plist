<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Defied Luminate helper, kept running in the background while you're signed in to this Mac.
     install.sh fills in the __PLACEHOLDERS__ and puts a copy in ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.defiedmgmt.luminate-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__APP__/luminate-helper.mjs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__LOGS__/helper.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/helper.log</string>
</dict>
</plist>
